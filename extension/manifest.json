{
  "manifest_version": 3,
  "name": "Page Text Extractor",
  "version": "1.0.0",
  "description": "Extract text from the current web page",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract page text"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
