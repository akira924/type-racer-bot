{
  "manifest_version": 3,
  "name": "TypeRacer Bot",
  "version": "1.1.0",
  "description": "Extract TypeRacer passage text and auto-type at a chosen WPM",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract page text"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
